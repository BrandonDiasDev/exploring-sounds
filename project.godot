; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Exploring Sounds"
config/description="2D infinite-scrolling grid with interactive sound instruments"
config/version="0.1.0"
run/main_scene="res://scenes/WorldExample.tscn"
config/features=PackedStringArray("4.6")
config/icon="res://icon.svg"
config/author="Zaazu"

[autoload]

AudioManager="*res://scenes/AudioManager.tscn"

[debug]

gdscript/warnings/unused_argument=1

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

